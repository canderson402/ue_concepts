# Unreal Engine 5 .gitignore

# Visual Studio user specific files
.vs/
.vsconfig

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Generated project files (regenerated by the engine)
*.xcodeproj/
*.xcworkspace/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# JetBrains Rider
.idea/
*.iml

# Visual Studio Code
.vscode/

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/
Plugins/**/Binaries/

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/

# Compiled source files for the engine to use
Intermediate/
Plugins/**/Intermediate/

# Cache files for the editor to use
DerivedDataCache/

# Crash logs and reports
*.log
CrashReportClient/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
